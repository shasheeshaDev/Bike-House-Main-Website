# Site
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — same project/dataset as the Studio, different variable prefix.
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID blank to render the built-in fallback
# content from the design.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-04-16
# Required when the dataset is private.
SANITY_API_READ_TOKEN=
# Shared secret for the publish webhook (app/api/revalidate).
SANITY_REVALIDATE_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bike House <website@bikehouse.lk>
# Inbox that receives contact-form submissions and newsletter sign-ups.
CONTACT_TO_EMAIL=chathurangasupun96@gmail.com

# Google Business Profile — feeds scripts/sync-google-reviews.mjs, which imports
# the workshop's own reviews as `testimonial` documents. Requires Business
# Profile API access granted by Google for this Cloud project, and an OAuth
# refresh token for an account that owns or manages the listing
# (scope: https://www.googleapis.com/auth/business.manage).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# From accounts.list / accounts.locations.list — include the resource prefix.
GOOGLE_BUSINESS_ACCOUNT_ID=accounts/
GOOGLE_BUSINESS_LOCATION_ID=locations/
# Stars required for a synced review to default to featured. Lower-rated ones
# are still imported, just not shown until someone ticks them in the Studio.
GOOGLE_REVIEWS_MIN_RATING=4
