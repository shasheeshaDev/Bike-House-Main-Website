# Site
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — same project/dataset as the Studio, different variable prefix.
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID blank to render the built-in fallback
# content from the design.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-04-16
# Required when the dataset is private.
SANITY_API_READ_TOKEN=
# Shared secret for the publish webhook (app/api/revalidate).
SANITY_REVALIDATE_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bike House <website@bikehouse.lk>
CONTACT_TO_EMAIL=hello@bikehouse.lk
